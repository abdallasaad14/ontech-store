<Window x:Class="OnTech.Store.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
        xmlns:vm="clr-namespace:OnTech.Store.Desktop.ViewModels"
        xmlns:views="clr-namespace:OnTech.Store.Desktop.Views"
        Title="{l:T 'OnTech Store'}" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/app.ico">
    <Window.Resources>
        <!-- Each page view model is shown with its view. -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewOrderViewModel}"><views:NewOrderView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddQuantityViewModel}"><views:AddQuantityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}"><views:OrdersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView/></DataTemplate>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Width="26" FontSize="15"/>
                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource NavItemTemplate}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <Image Source="/Assets/ontech-logo-wordmark.png" Height="20" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                    <TextBlock Text="STORE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="1,5,0,0"/>
                </StackPanel>

                <!-- Signed-in user -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding UserInitials}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="-6,8,0,0">
                            <Button Content="{l:T 'Password'}" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding ChangePasswordCommand}"/>
                            <Button Content="{l:T 'Sign out'}" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding SignOutCommand}"/>
                            <Button Content="{Binding OtherLanguage}" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding SwitchLanguageCommand}"
                                    ToolTip="{l:T 'Change the language'}"/>
                        </StackPanel>
                        <TextBlock FontSize="10" Foreground="{StaticResource BrandGrayBrush}" Margin="0,4,0,0">
                            <Run Text="{l:T 'Server'}"/> <Run Text="{Binding ServerAddress, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding MainMenu}" SelectedItem="{Binding SelectedMainItem}"/>
                    <StackPanel Visibility="{Binding HasAdminMenu, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T 'ADMIN'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="10,20,0,6"/>
                        <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding AdminMenu}" SelectedItem="{Binding SelectedAdminItem}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
