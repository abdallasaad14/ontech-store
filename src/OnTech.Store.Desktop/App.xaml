<Application x:Class="OnTech.Store.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OnTech.Store.Desktop"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:HasValueToVisibilityConverter x:Key="HasValueToVisibility"/>
            <local:InverseBoolConverter x:Key="InverseBool"/>
            <local:LocalTimeConverter x:Key="LocalTime"/>
            <local:UserAccessConverter x:Key="UserAccess"/>
            <local:CanCancelOrderConverter x:Key="CanCancelOrder"/>
            <local:TranslateConverter x:Key="Translate"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
