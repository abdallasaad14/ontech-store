<UserControl x:Class="OnTech.Store.Desktop.Views.StockPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: ItemDto. Green "In stock", amber "Low", red "Out of stock", gray "Disabled". -->
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Quantity}" Value="0">
                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock FontSize="11" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="In stock"/>
                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter Property="Text" Value="Low"/>
                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                            <Setter Property="Text" Value="Out of stock"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Text" Value="Disabled"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
