<UserControl x:Class="OnTech.Store.Desktop.Views.NewOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="New Order" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose what is leaving the store and who it is for. Stock is deducted when you save." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
            <views:MessageBanners/>

            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="Item" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding Quantity, StringFormat='{}{0} available'}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AvailableHint}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Visibility="{Binding AvailableHint, Converter={StaticResource HasValueToVisibility}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Add another item" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                        Command="{Binding AddLineCommand}" ToolTip="Keep this item in the order and pick another one"/>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ New customer" Style="{StaticResource LinkButton}" Margin="0,-6,0,0"
                                        Command="{Binding QuickAddCustomerCommand}"
                                        Visibility="{Binding CanAddCustomer, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Customer (type number or name)" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,6"
                                     ToolTip="Type the customer number or part of the name"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Display"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Display"/>
                        </StackPanel>
                    </Grid>

                    <!-- Items already in this order -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Margin="0,0,0,16"
                            Visibility="{Binding Lines.Count, Converter={StaticResource HasValueToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="12,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='× {0}'}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <CheckBox Content="Add a receipt" IsChecked="{Binding WithReceipt}" Margin="0,0,0,10"/>
                    <StackPanel Visibility="{Binding WithReceipt, Converter={StaticResource BoolToVisibility}}" Margin="24,0,0,16" MaxWidth="400" HorizontalAlignment="Left">
                        <TextBlock Text="Receipt number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Each receipt number can be used once. You can search orders by it later."/>
                    </StackPanel>

                    <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource MultiLineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource SoftStrip}" Margin="0,0,0,18" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Margin="0,0,8,0" MinWidth="90" Command="{Binding CancelCommand}"/>
                        <Button Content="Save order" Style="{StaticResource PrimaryButton}" MinWidth="120" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
