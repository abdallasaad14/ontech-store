<UserControl x:Class="OnTech.Store.Desktop.Views.NewOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{l:T 'New Order'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Choose what is leaving the store and who it is for. Stock is deducted when you save.'}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
            <views:MessageBanners/>

            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="OrderTypeLabel" Text="{l:T 'Type'}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" AutomationProperties.LabeledBy="{Binding ElementName=OrderTypeLabel}">
                        <RadioButton AutomationProperties.AutomationId="NewOrder_SaleRadio" GroupName="NewOrderType" Style="{StaticResource SegmentButton}"
                                     Content="{l:T 'Sale'}" IsChecked="{Binding IsSale}"/>
                        <RadioButton AutomationProperties.AutomationId="NewOrder_DemoRadio" GroupName="NewOrderType" Style="{StaticResource DemoSegmentButton}"
                                     Content="{l:T 'Demo'}" IsChecked="{Binding IsDemo}"/>
                    </StackPanel>
                    <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                       Text="{l:T 'A demo goes out to the customer to try. Stock goes down now, and the items stay on the customer until you receive them back with a demo return voucher. A demo has no receipt.'}"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock x:Name="CategoryLabel" Text="{l:T 'Category'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox AutomationProperties.AutomationId="NewOrder_CategoryCombo" AutomationProperties.LabeledBy="{Binding ElementName=CategoryLabel}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock x:Name="ItemLabel" Text="{l:T 'Item'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox AutomationProperties.AutomationId="NewOrder_ItemCombo" AutomationProperties.LabeledBy="{Binding ElementName=ItemLabel}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding Quantity, StringFormat={l:T '\{0\} available'}}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <DockPanel Visibility="{Binding SelectedItem, Converter={StaticResource HasValueToVisibility}}">
                                <Button AutomationProperties.AutomationId="NewOrder_OpenCardButton" DockPanel.Dock="Right" Content="{l:T 'Item card'}" Style="{StaticResource LinkButton}" FontSize="12" Margin="10,0,0,0"
                                        Command="{Binding OpenCardCommand}" ToolTip="{l:T 'Every movement of this item in and out'}"
                                        Visibility="{Binding CanOpenItemCard, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding AvailableHint}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock x:Name="QuantityLabel" Text="{l:T 'Quantity'}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button AutomationProperties.AutomationId="NewOrder_AddLineButton" DockPanel.Dock="Right" Content="{l:T '+ Add another item'}" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                        Command="{Binding AddLineCommand}" ToolTip="{l:T 'Keep this item in the order and pick another one'}"/>
                                <TextBox AutomationProperties.AutomationId="NewOrder_QuantityBox" AutomationProperties.LabeledBy="{Binding ElementName=QuantityLabel}" MaxLength="9" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                            <DockPanel>
                                <Button AutomationProperties.AutomationId="NewOrder_QuickAddCustomerButton" DockPanel.Dock="Right" Content="{l:T '+ New customer'}" Style="{StaticResource LinkButton}" Margin="0,-6,0,0"
                                        Command="{Binding QuickAddCustomerCommand}"
                                        Visibility="{Binding CanAddCustomer, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock x:Name="CustomerSearchLabel" Text="{l:T 'Customer (type number or name)'}" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <TextBox AutomationProperties.AutomationId="NewOrder_CustomerSearchBox" AutomationProperties.LabeledBy="{Binding ElementName=CustomerSearchLabel}" MaxLength="200" Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,0,6"
                                     ToolTip="{l:T 'Type the customer number or part of the name'}"/>
                            <ComboBox AutomationProperties.AutomationId="NewOrder_CustomerCombo" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Display"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Display"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock x:Name="IssueVoucherNumberLabel" Text="{l:T 'Issue voucher number *'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox AutomationProperties.AutomationId="NewOrder_IssueVoucherNumberBox" AutomationProperties.LabeledBy="{Binding ElementName=IssueVoucherNumberLabel}" MaxLength="30" Text="{Binding IssueVoucherNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The number on the warehouse issue voucher. Required, and each number is used once.'}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16" Visibility="{Binding IsSale, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox AutomationProperties.AutomationId="NewOrder_WithReceiptCheck" Content="{l:T 'Add a receipt'}" IsChecked="{Binding WithReceipt}" Margin="0,0,0,8"/>
                            <StackPanel Visibility="{Binding WithReceipt, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock x:Name="ReceiptNumberLabel" Text="{l:T 'Receipt number'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox AutomationProperties.AutomationId="NewOrder_ReceiptNumberBox" AutomationProperties.LabeledBy="{Binding ElementName=ReceiptNumberLabel}" MaxLength="50" Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Each receipt number can be used once. You can search orders by it later.'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Items already in this order -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Margin="0,0,0,16"
                            Visibility="{Binding Lines.Count, Converter={StaticResource HasValueToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="12,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button AutomationProperties.AutomationId="NewOrder_RemoveLineButton" DockPanel.Dock="Right" Content="{l:T 'Remove'}" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='× {0}'}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock x:Name="NotesLabel" Text="{l:T 'Notes (optional)'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.AutomationId="NewOrder_NotesBox" AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}" MaxLength="1000" Style="{StaticResource MultiLineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource SoftStrip}" Margin="0,0,0,18" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button AutomationProperties.AutomationId="NewOrder_CancelButton" Content="{l:T 'Cancel'}" Margin="0,0,8,0" MinWidth="90" Command="{Binding CancelCommand}"/>
                        <Button AutomationProperties.AutomationId="NewOrder_SaveButton" Content="{Binding SaveText}" Style="{StaticResource PrimaryButton}" MinWidth="120" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
