<UserControl x:Class="OnTech.Store.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel>
        <DockPanel.Style>
            <!-- On the Demo page this log sits inside a tab, under the page's own title. -->
            <Style TargetType="DockPanel">
                <Setter Property="Margin" Value="32,28,32,24"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDemoLog}" Value="True">
                        <Setter Property="Margin" Value="0,12,0,0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20" Visibility="{Binding IsSaleLog, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:T 'Orders Log'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Every sale taken from the store, newest first. Demos are on the Demo page. Search by issue voucher, receipt number, customer or item.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <ComboBox AutomationProperties.AutomationId="Orders_ReceiptFilterCombo" DockPanel.Dock="Right" Width="160" Margin="8,0,0,0" ItemsSource="{Binding ReceiptFilters}" SelectedIndex="{Binding ReceiptFilterIndex}"
                                  Visibility="{Binding IsSaleLog, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox AutomationProperties.AutomationId="Orders_DemoStateFilterCombo" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" ItemsSource="{Binding DemoStateFilters}" SelectedIndex="{Binding DemoStateFilterIndex}"
                                  Visibility="{Binding IsDemoLog, Converter={StaticResource BoolToVisibility}}"/>
                        <Button AutomationProperties.AutomationId="Orders_SearchButton" DockPanel.Dock="Right" Content="{l:T 'Search'}" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                        <TextBox AutomationProperties.AutomationId="Orders_SearchBox" Style="{StaticResource SearchBox}" Tag="{Binding SearchHint}" MaxLength="100" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <!-- Only one customer's vouchers, with their totals at the bottom. -->
                    <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                        <TextBlock x:Name="PartyLabel" DockPanel.Dock="Left" Text="{Binding PartyLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox AutomationProperties.AutomationId="Orders_PartySearchBox" Style="{StaticResource SearchBox}" Tag="{Binding PartyPlaceholder}" AutomationProperties.LabeledBy="{Binding ElementName=PartyLabel}" DockPanel.Dock="Left" Width="200" MaxLength="200"
                                 Text="{Binding Party.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="{Binding PartyHint}"/>
                        <Button AutomationProperties.AutomationId="Orders_PartyClearButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                Content="{Binding PartyAllText}" Command="{Binding Party.ClearCommand}"/>
                        <ComboBox AutomationProperties.AutomationId="Orders_PartyCombo" AutomationProperties.LabeledBy="{Binding ElementName=PartyLabel}" Margin="8,0,0,0"
                                  ItemsSource="{Binding Party.Choices}" SelectedItem="{Binding Party.Selected}" DisplayMemberPath="Display"/>
                    </DockPanel>
                    <!-- One number book: a number that belongs to the other type says where it is. -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource WarnSoftBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="12,8" Margin="16,0,16,8"
                            Visibility="{Binding OtherTypeHint, Converter={StaticResource HasValueToVisibility}}">
                        <DockPanel>
                            <Button AutomationProperties.AutomationId="Orders_OpenOtherTypeButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                    Content="{l:T 'Open it'}" Command="{Binding OpenOtherTypeCommand}"/>
                            <TextBlock Text="{Binding OtherTypeHint}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button AutomationProperties.AutomationId="Orders_PreviousPageButton" Content="{l:T 'Previous'}" Margin="0,0,8,0" Command="{Binding PreviousPageCommand}"/>
                            <Button AutomationProperties.AutomationId="Orders_NextPageButton" Content="{l:T 'Next'}" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TotalsText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </DockPanel>
                    <DataGrid AutomationProperties.AutomationId="Orders_OrdersGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" Margin="6,0,6,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'ISSUE VOUCHER'}" Binding="{Binding IssueVoucherNumber}" Width="130" FontWeight="SemiBold"/>
                            <DataGridTextColumn x:Name="DemoStateColumn" Header="{l:T 'STATE'}" Binding="{Binding Converter={StaticResource DemoState}, Mode=OneWay}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OpenQuantity}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{l:T 'DATE'}" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="{l:T 'CUSTOMER'}" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="{l:T 'UNITS'}" Binding="{Binding TotalQuantity}" Width="70"/>
                            <DataGridTextColumn x:Name="OpenColumn" Header="{l:T 'STILL OUT'}" Binding="{Binding OpenQuantity, Converter={StaticResource ZeroAsBlank}, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn x:Name="ReceiptColumn" Header="{l:T 'RECEIPT'}" Binding="{Binding ReceiptNumber}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'BY'}" Binding="{Binding CreatedByUserName}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'STATUS'}" Binding="{Binding Status, Converter={StaticResource Translate}, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Selected order -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="320" Margin="16,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding IssueVoucherNumber, StringFormat={l:T 'Issue voucher \{0\}'}}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}, ConverterParameter='dddd d MMMM yyyy, HH:mm'}" Style="{StaticResource Hint}"/>

                        <TextBlock Text="{l:T 'TYPE'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding Type, Converter={StaticResource VoucherType}}" FontWeight="SemiBold"/>
                        <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="10,6" Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Demo">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap">
                                <Run Text="{l:T 'Back:'}"/> <Run Text="{Binding ReturnedQuantity, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" · "/><Run Text="{l:T 'Still with the customer:'}"/> <Run Text="{Binding OpenQuantity, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{l:T 'CUSTOMER'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CustomerTaxNumber, StringFormat={l:T 'Tax no. {0}'}}" Style="{StaticResource Hint}"
                                   Visibility="{Binding CustomerTaxNumber, Converter={StaticResource HasValueToVisibility}}"/>

                        <TextBlock Text="{l:T 'ITEMS'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='× {0}'}" FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,8,0" Foreground="{StaticResource WarnBrush}" FontSize="11" VerticalAlignment="Center"
                                                   Text="{Binding ReturnedQuantity, StringFormat={l:T '\{0\} back'}}"
                                                   Visibility="{Binding ReturnedQuantity, Converter={StaticResource HasValueToVisibility}}"/>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding ItemName, Mode=OneWay}"/> <Run Text="{Binding CategoryName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Demo">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{l:T 'RECEIPT'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding ReceiptNumber, TargetNullValue={l:T 'No receipt'}}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Notes, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="{l:T 'NOTES'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="{l:T 'CREATED BY'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CreatedByUserName}"/>

                        <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                                Visibility="{Binding CancelledAt, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}">
                                <Run Text="{l:T 'Cancelled by'}"/> <Run Text="{Binding CancelledByUserName, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding CancelReason, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <Button AutomationProperties.AutomationId="Orders_CancelOrderButton" Content="{l:T 'Cancel order'}" Style="{StaticResource DangerButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" x:Name="CancelButton">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource CanCancelOrder}">
                                    <Binding Path="DataContext.CanCancel" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <Button AutomationProperties.AutomationId="Orders_ChangeTypeButton" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.ChangeTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{l:T 'Admin only: for an order saved with the wrong type'}"
                                Style="{StaticResource LinkButton}" Content="{l:T 'Mark as demo'}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource CanCancelOrder}">
                                    <Binding Path="DataContext.CanChangeType" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
