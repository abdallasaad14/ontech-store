<UserControl x:Class="OnTech.Store.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Orders Log" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Every order taken from the store, newest first. Search by order number, receipt number, customer or item." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <ComboBox DockPanel.Dock="Right" Width="160" Margin="8,0,0,0" ItemsSource="{Binding ReceiptFilters}" SelectedItem="{Binding ReceiptFilter}"/>
                        <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Previous" Margin="0,0,8,0" Command="{Binding PreviousPageCommand}"/>
                            <Button Content="Next" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" Margin="6,0,6,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ORDER" Binding="{Binding OrderNumber}" Width="110" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="UNITS" Binding="{Binding TotalQuantity}" Width="70"/>
                            <DataGridTextColumn Header="RECEIPT" Binding="{Binding ReceiptNumber}" Width="*"/>
                            <DataGridTextColumn Header="BY" Binding="{Binding CreatedByUserName}" Width="*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Selected order -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="320" Margin="16,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}, ConverterParameter='dddd d MMMM yyyy, HH:mm'}" Style="{StaticResource Hint}"/>

                        <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CustomerTaxNumber, StringFormat='Tax no. {0}'}" Style="{StaticResource Hint}"
                                   Visibility="{Binding CustomerTaxNumber, Converter={StaticResource HasValueToVisibility}}"/>

                        <TextBlock Text="ITEMS" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='× {0}'}" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding ItemName, Mode=OneWay}"/> <Run Text="{Binding CategoryName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="RECEIPT" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding ReceiptNumber, TargetNullValue='No receipt'}"/>

                        <StackPanel Visibility="{Binding Notes, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="CREATED BY" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CreatedByUserName}"/>

                        <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                                Visibility="{Binding CancelledAt, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}">
                                <Run Text="Cancelled by"/> <Run Text="{Binding CancelledByUserName, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding CancelReason, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <Button Content="Cancel order" Style="{StaticResource DangerButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" x:Name="CancelButton">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource CanCancelOrder}">
                                    <Binding Path="DataContext.CanCancel" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
