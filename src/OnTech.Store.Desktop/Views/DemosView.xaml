<UserControl x:Class="OnTech.Store.Desktop.Views.DemosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <!-- Title and the two demo actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button AutomationProperties.AutomationId="Demos_NewDemoButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding NewDemoCommand}" Visibility="{Binding CanCreateDemo, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="{l:T 'New demo voucher'}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="Demos_NewReturnButton"
                        Command="{Binding NewReturnCommand}" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T 'Demo return'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:T 'Demos'}" Style="{StaticResource PageTitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Tabs -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding CanSeeLogs, Converter={StaticResource BoolToVisibility}}">
            <RadioButton AutomationProperties.AutomationId="Demos_OpenTab" GroupName="DemosTabs" Style="{StaticResource DemoSegmentButton}"
                         Content="{l:T 'With customers now'}" IsChecked="{Binding IsOpenTab}"/>
            <RadioButton AutomationProperties.AutomationId="Demos_IssuesTab" GroupName="DemosTabs" Style="{StaticResource DemoSegmentButton}"
                         Content="{l:T 'Demo issue vouchers'}" IsChecked="{Binding IsIssuesTab}"/>
            <RadioButton AutomationProperties.AutomationId="Demos_ReturnsTab" GroupName="DemosTabs" Style="{StaticResource DemoSegmentButton}"
                         Content="{l:T 'Demo returns'}" IsChecked="{Binding IsReturnsTab}"/>
        </StackPanel>

        <Grid>
            <!-- Tab 0: with customers now -->
            <DockPanel Visibility="{Binding IsOpenTab, Converter={StaticResource BoolToVisibility}}">
                <views:MessageBanners DockPanel.Dock="Top"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="{l:T 'You can make demo vouchers here. To see what is out with customers, ask an admin for the Stock In or View Orders permission.'}"
                           Visibility="{Binding CannotSeeOpen, Converter={StaticResource BoolToVisibility}}"/>
                <Grid Visibility="{Binding CanSeeOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                                <ComboBox AutomationProperties.AutomationId="Demos_GroupModeCombo" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                                          ItemsSource="{Binding GroupModes}" SelectedIndex="{Binding GroupMode}"/>
                                <Button AutomationProperties.AutomationId="Demos_SearchButton" DockPanel.Dock="Right" Content="{l:T 'Search'}" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                                <TextBox AutomationProperties.AutomationId="Demos_SearchBox" Style="{StaticResource SearchBox}" Tag="{l:T 'Voucher, customer or item'}" MaxLength="100" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{l:T 'Customer name or number, item name or code, or issue voucher number'}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
                                <Button AutomationProperties.AutomationId="Demos_RefreshButton" DockPanel.Dock="Right" Content="{l:T 'Refresh'}" Command="{Binding RefreshCommand}"/>
                                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                            </DockPanel>
                            <DataGrid AutomationProperties.AutomationId="Demos_OpenGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" Margin="6,0,6,0">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,12,8,4" Foreground="{StaticResource TextBrush}"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="CustomerColumn" Header="{l:T 'CUSTOMER'}" Binding="{Binding Customer, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn x:Name="ItemColumn" Header="{l:T 'ITEM'}" Binding="{Binding Item, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="{l:T 'ISSUE VOUCHER'}" Binding="{Binding Line.IssueVoucherNumber, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="{l:T 'DATE'}" Binding="{Binding Line.CreatedAt, Converter={StaticResource LocalTime}, ConverterParameter='d MMM yyyy', Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="{l:T 'DAYS OUT'}" Binding="{Binding DaysOut, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="{l:T 'WENT OUT'}" Binding="{Binding Line.Quantity, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="{l:T 'BACK'}" Binding="{Binding Line.ReturnedQuantity, Converter={StaticResource ZeroAsBlank}, Mode=OneWay}" Width="60"/>
                                    <DataGridTextColumn Header="{l:T 'STILL OUT'}" Binding="{Binding Line.OpenQuantity, Mode=OneWay}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Selected line -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Width="300" Margin="16,0,0,0"
                            Visibility="{Binding SelectedRow, Converter={StaticResource HasValueToVisibility}}">
                        <StackPanel>
                            <StackPanel DataContext="{Binding SelectedRow}">
                                <TextBlock Text="{Binding Item}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Line.CategoryName}" Style="{StaticResource Hint}"/>

                                <TextBlock Text="{l:T 'CUSTOMER'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                                <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <TextBlock Text="{l:T 'ISSUE VOUCHER'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                                <TextBlock Text="{Binding Line.IssueVoucherNumber}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Line.CreatedAt, Converter={StaticResource LocalTime}, ConverterParameter='dddd d MMMM yyyy, HH:mm'}" Style="{StaticResource Hint}"/>

                                <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="10,6" Margin="0,16,0,0">
                                    <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap">
                                        <Run Text="{l:T 'Still with the customer:'}"/> <Run Text="{Binding Line.OpenQuantity, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/><Run Text="{l:T 'Days out:'}"/> <Run Text="{Binding DaysOut, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <Button AutomationProperties.AutomationId="Demos_ReturnLineButton" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                                    Content="{l:T 'Return'}" ToolTip="{l:T 'Opens a demo return for this customer with this line filled in'}"
                                    Command="{Binding ReturnLineCommand}" CommandParameter="{Binding SelectedRow}"
                                    Visibility="{Binding CanReturn, Converter={StaticResource BoolToVisibility}}"/>
                            <Button AutomationProperties.AutomationId="Demos_OpenVoucherButton" Style="{StaticResource LinkButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Content="{l:T 'Open the voucher'}" Command="{Binding OpenVoucherCommand}" CommandParameter="{Binding SelectedRow}"
                                    Visibility="{Binding CanSeeLogs, Converter={StaticResource BoolToVisibility}}"/>
                            <Button AutomationProperties.AutomationId="Demos_OpenCardButton" Style="{StaticResource LinkButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Content="{l:T 'Item card'}" Command="{Binding OpenCardCommand}" CommandParameter="{Binding SelectedRow}"
                                    Visibility="{Binding CanOpenCard, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Tab 1: demo issue vouchers (the issue log, demos only) -->
            <ContentControl Content="{Binding Issues}" Focusable="False"
                            Visibility="{Binding IsIssuesTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Tab 2: demo returns (the receive log, demo returns only) -->
            <ContentControl Content="{Binding Returns}" Focusable="False"
                            Visibility="{Binding IsReturnsTab, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</UserControl>
