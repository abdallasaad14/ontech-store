<UserControl x:Class="OnTech.Store.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="+ Add customer" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"
                    Command="{Binding StartNewCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
            <Button DockPanel.Dock="Right" Content="Import from Excel" VerticalAlignment="Top" Margin="0,0,8,0"
                    ToolTip="Add customers from an .xlsx or .csv sheet (number + company name, phone and tax number optional)"
                    Command="{Binding ImportCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel>
                <TextBlock Text="Customers" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Companies that take items from the store." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <CheckBox DockPanel.Dock="Right" Content="Show disabled" IsChecked="{Binding ShowDisabled}" Margin="12,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Customer number or company name (also phone, tax number, contact)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <DataGrid x:Name="CustomersGrid" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" Margin="6,0,6,6"
                              MouseDoubleClick="OnDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO." Binding="{Binding CustomerNumber}" Width="70"/>
                            <DataGridTextColumn Header="COMPANY" Binding="{Binding CompanyName}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PHONE" Binding="{Binding PhoneNumber}" Width="*"/>
                            <DataGridTextColumn Header="TAX NUMBER" Binding="{Binding TaxNumber}" Width="*"/>
                            <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactPerson}" Width="*"/>
                            <DataGridTextColumn Header="ORDERS" Binding="{Binding OrderCount}" Width="80"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="Edit" Style="{StaticResource LinkButton}" FontSize="12"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Disable" Style="{StaticResource LinkButton}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Add / edit form -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="340" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <TextBlock Text="Customer number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomerNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                        <TextBlock Text="Leave empty to use the next free number." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <TextBlock Text="Company name *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Tax number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,18"
                                  Visibility="{Binding EditingId, Converter={StaticResource HasValueToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="90" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
