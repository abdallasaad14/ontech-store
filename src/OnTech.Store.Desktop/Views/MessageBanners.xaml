<UserControl x:Class="OnTech.Store.Desktop.Views.MessageBanners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shows the DataContext's ErrorMessage / SuccessMessage (see ViewModelBase). -->
    <StackPanel>
        <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource DangerBrush}"
                           Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource SuccessBanner}" Margin="0,0,0,12"
                Visibility="{Binding SuccessMessage, Converter={StaticResource HasValueToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource OkBrush}"
                           Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource OkBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
