<UserControl x:Class="OnTech.Store.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Today}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
            <views:MessageBanners/>

            <!-- The three home actions -->
            <UniformGrid Rows="1" Margin="-6,0,-6,20">
                <Button Style="{StaticResource PrimaryActionCard}" Margin="6,0" Command="{Binding NewOrderCommand}"
                        Visibility="{Binding CanCreateOrders, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="22" HorizontalAlignment="Left"/>
                        <TextBlock Text="New Order" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2"/>
                        <TextBlock Text="Take items out for a customer" FontSize="12" Opacity="0.85"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionCard}" Margin="6,0" Command="{Binding AddQuantityCommand}"
                        Visibility="{Binding CanAddStock, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Add Quantity" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="Stock received for existing items" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionCard}" Margin="6,0" Command="{Binding AddCustomerCommand}"
                        Visibility="{Binding CanManageCustomers, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Add Customer" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="Company name, number, tax number" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Today at a glance -->
            <UniformGrid Rows="1" Margin="-6,0,-6,20" Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Units in stock" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Summary.TotalUnitsInStock}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Low stock" Style="{StaticResource FieldLabel}"/>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}">
                            <Run Text="{Binding Summary.LowStockItemCount, Mode=OneWay}"/><Run Text=" items" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Orders today" Style="{StaticResource FieldLabel}"/>
                        <TextBlock FontSize="22" FontWeight="SemiBold">
                            <Run Text="{Binding Summary.OrdersToday, Mode=OneWay}"/><Run Text="{Binding Summary.UnitsOutToday, Mode=OneWay, StringFormat=' · {0} units out'}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Customers" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Summary.CustomerCount}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Stock available -->
        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,20,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox Width="180" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                        <TextBox Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by item name or code">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding RefreshCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="8,0,0,0" Padding="11,8"
                                ToolTip="Refresh" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Stock available" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Double-click an item to start an order with it." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="StockGrid" ItemsSource="{Binding Items}" Margin="10,0,10,10" MouseDoubleClick="OnStockDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="*"/>
                        <DataGridTextColumn Header="AVAILABLE" Binding="{Binding Quantity}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="STATUS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><views:StockPill/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
