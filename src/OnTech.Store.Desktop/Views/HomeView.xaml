<UserControl x:Class="OnTech.Store.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Today}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>
            <views:MessageBanners/>

            <!-- The three home actions -->
            <UniformGrid Rows="1" Margin="-6,0,-6,20">
                <Button AutomationProperties.AutomationId="Home_NewOrderButton" Style="{StaticResource PrimaryActionCard}" Margin="6,0" Command="{Binding NewOrderCommand}"
                        Visibility="{Binding CanCreateOrders, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="22" HorizontalAlignment="Left"/>
                        <TextBlock Text="{l:T 'New Order'}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="Home_StockInButton" Style="{StaticResource ActionCard}" Margin="6,0" Command="{Binding StockInCommand}"
                        Visibility="{Binding CanAddStock, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{l:T 'Stock In'}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="Home_AddCustomerButton" Style="{StaticResource ActionCard}" Margin="6,0" Command="{Binding AddCustomerCommand}"
                        Visibility="{Binding CanManageCustomers, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{l:T 'Add Customer'}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Today at a glance: every card is title, one big number, optional note. European digits keep the numbers alike in Arabic. -->
            <UniformGrid Rows="1" Margin="-6,0,-6,20" NumberSubstitution.Substitution="European" Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}">
                <UniformGrid.Resources>
                    <Style x:Key="StatNumber" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="26"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    </Style>
                    <Style x:Key="StatNote" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="Margin" Value="0,2,0,0"/>
                    </Style>
                </UniformGrid.Resources>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Units in stock'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_UnitsInStock" Text="{Binding Summary.TotalUnitsInStock}" Style="{StaticResource StatNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Low stock'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_LowStockCount" Text="{Binding Summary.LowStockItemCount}" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="{l:T 'items'}" Style="{StaticResource StatNote}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Orders today'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_OrdersToday" Text="{Binding Summary.OrdersToday}" Style="{StaticResource StatNumber}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_UnitsOutToday" Text="{Binding Summary.UnitsOutToday, StringFormat={l:T '\{0\} units out'}}" Style="{StaticResource StatNote}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,18">
                    <StackPanel>
                        <TextBlock x:Name="CategoryLabel" Text="{l:T 'Customers'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_CustomerCount" Text="{Binding Summary.CustomerCount}" Style="{StaticResource StatNumber}"/>
                    </StackPanel>
                </Border>
                <!-- Demos still out: opens the Demo page. ActionCard already pads 20,18. -->
                <Button AutomationProperties.AutomationId="Home_DemosCard" Style="{StaticResource ActionCard}" Margin="6,0" Command="{Binding OpenDemosCommand}"
                        ToolTip="{l:T 'Open the Demo page'}" Visibility="{Binding CanOpenDemos, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Demos with customers'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_OpenDemoQuantity" Text="{Binding Summary.OpenDemoQuantity}" Style="{StaticResource StatNumber}"/>
                        <TextBlock AutomationProperties.AutomationId="Home_OpenDemoCustomers" Text="{Binding Summary.OpenDemoCustomers, StringFormat={l:T '\{0\} customers'}}" Style="{StaticResource StatNote}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- Stock available -->
        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,20,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox AutomationProperties.AutomationId="Home_CategoryCombo" AutomationProperties.LabeledBy="{Binding ElementName=CategoryLabel}" Width="180" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                        <TextBox AutomationProperties.AutomationId="Home_SearchBox" Style="{StaticResource SearchBox}" Tag="{l:T 'Item name, code or category'}" MaxLength="100" Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'Search by item name or code'}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding RefreshCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button AutomationProperties.AutomationId="Home_RefreshButton" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="8,0,0,0" Padding="11,8"
                                ToolTip="{l:T 'Refresh'}" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Stock available'}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid AutomationProperties.AutomationId="Home_StockGrid" x:Name="StockGrid" ItemsSource="{Binding Items}" Margin="10,0,10,10" MouseDoubleClick="OnStockDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'ITEM'}" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="{l:T 'CODE'}" Binding="{Binding Code}" Width="*"/>
                        <DataGridTextColumn Header="{l:T 'CATEGORY'}" Binding="{Binding CategoryName}" Width="*"/>
                        <DataGridTextColumn Header="{l:T 'AVAILABLE'}" Binding="{Binding Quantity}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="{l:T 'STATUS'}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><views:StockPill/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button AutomationProperties.AutomationId="Home_OpenCardButton" Content="{l:T 'Item card'}" Style="{StaticResource LinkButton}" FontSize="12"
                                            Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
