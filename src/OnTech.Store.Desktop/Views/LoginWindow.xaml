<Window x:Class="OnTech.Store.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
        xmlns:views="clr-namespace:OnTech.Store.Desktop.Views"
        Title="{l:T 'OnTech Store - Sign in'}" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/app.ico">
    <Border Style="{StaticResource Card}" Margin="28" Padding="32,30">
        <StackPanel>
            <Grid>
                <Image Source="/Assets/ontech-logo-wordmark.png" Height="30" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                <Button AutomationProperties.AutomationId="Login_SwitchLanguageButton" Content="{Binding OtherLanguage}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding SwitchLanguageCommand}" ToolTip="{l:T 'Change the language'}"/>
            </Grid>
            <TextBlock Text="STORE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,22"/>

            <TextBlock Text="{l:T 'Sign in'}" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

            <views:MessageBanners/>

            <TextBlock x:Name="UsernameLabel" Text="{l:T 'Username'}" Style="{StaticResource FieldLabel}"/>
            <TextBox AutomationProperties.AutomationId="Login_UsernameBox" AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}" MaxLength="64" x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock x:Name="PasswordLabel" Text="{l:T 'Password'}" Style="{StaticResource FieldLabel}"/>
            <!-- The eye button swaps the hidden PasswordBox for a plain TextBox showing the same text. -->
            <Grid Margin="0,0,0,16">
                <PasswordBox AutomationProperties.AutomationId="Login_PasswordBox" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" MaxLength="128" x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" Padding="9,7,40,7"/>
                <TextBox AutomationProperties.AutomationId="Login_PasswordTextBox" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" MaxLength="128" x:Name="PasswordText" TextChanged="OnPasswordTextChanged" Padding="9,7,40,7" Visibility="Collapsed"/>
                <ToggleButton AutomationProperties.AutomationId="Login_ShowPasswordToggle" x:Name="ShowPassword" HorizontalAlignment="Right" Margin="0,0,4,0" Width="32" Height="28"
                              Cursor="Hand" Focusable="False" ToolTip="{l:T 'Show password'}"
                              Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                <TextBlock x:Name="Glyph" Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <!-- Server address: collapsed to one line once this PC has signed in before. -->
            <DockPanel Visibility="{Binding IsEditingServer, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" Margin="0,0,0,18">
                <Button AutomationProperties.AutomationId="Login_EditServerButton" DockPanel.Dock="Right" Content="{l:T 'Change'}" Style="{StaticResource LinkButton}" Command="{Binding EditServerCommand}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                    <Run Text="{l:T 'Server:'}"/> <Run Text="{Binding ServerUrl, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
            <StackPanel Visibility="{Binding IsEditingServer, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,18">
                <TextBlock x:Name="ServerUrlLabel" Text="{l:T 'Server address'}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button AutomationProperties.AutomationId="Login_TestConnectionButton" DockPanel.Dock="Right" Content="{l:T 'Test'}" Margin="8,0,0,0" Command="{Binding TestConnectionCommand}"/>
                    <TextBox AutomationProperties.AutomationId="Login_ServerUrlBox" AutomationProperties.LabeledBy="{Binding ElementName=ServerUrlLabel}" MaxLength="200" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </StackPanel>

            <Button AutomationProperties.AutomationId="Login_SignInButton" Content="{l:T 'Sign in'}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinHeight="40"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </StackPanel>
    </Border>
</Window>
