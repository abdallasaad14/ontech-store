<UserControl x:Class="OnTech.Store.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="+ Add user" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Command="{Binding NewUserCommand}"/>
            <StackPanel>
                <TextBlock Text="Users" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Who can sign in, and what each person is allowed to do. Changes apply right away on every PC." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="UsersGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" Margin="6" MouseDoubleClick="OnDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="ACCESS" Binding="{Binding Converter={StaticResource UserAccess}, Mode=OneWay}" Width="1.4*"/>
                        <DataGridTextColumn Header="LAST SIGN-IN" Binding="{Binding LastLoginAt, Converter={StaticResource LocalTime}, Mode=OneWay}" Width="130"/>
                        <DataGridTemplateColumn Header="STATUS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Disabled"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button Content="Reset password" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button Content="Disable" Style="{StaticResource LinkButton}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Add / edit form -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Username * (used to sign in)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Text="For example ahmed or ahmed.ali. No spaces." Margin="0,0,0,12"/>
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="First password * (at least 8 characters)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <CheckBox Content="Ask them to choose their own password at first sign-in" IsChecked="{Binding MustChangePassword}" Margin="0,0,0,12"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding IsAdmin}" Margin="0,4,0,4">
                            <TextBlock><Run Text="Admin" FontWeight="SemiBold"/> <Run Text="(can do everything)" Foreground="{StaticResource TextMutedBrush}"/></TextBlock>
                        </CheckBox>

                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <DockPanel Margin="0,12,0,6">
                                <Button DockPanel.Dock="Right" Content="Standard set" Style="{StaticResource LinkButton}" FontSize="12"
                                        Command="{Binding UseStandardPermissionsCommand}" ToolTip="Home page actions plus the orders log"/>
                                <TextBlock Text="PERMISSIONS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PermissionOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <CheckBox Content="Active (can sign in)" IsChecked="{Binding IsActive}" Margin="0,14,0,0"
                                  Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="90" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
