<UserControl x:Class="OnTech.Store.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button AutomationProperties.AutomationId="Users_NewUserButton" DockPanel.Dock="Right" Content="{l:T '+ Add user'}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Command="{Binding NewUserCommand}"/>
            <StackPanel>
                <TextBlock Text="{l:T 'Users'}" Style="{StaticResource PageTitle}"/>
            </StackPanel>
        </DockPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid AutomationProperties.AutomationId="Users_UsersGrid" x:Name="UsersGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" Margin="6" MouseDoubleClick="OnDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'NAME'}" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="{l:T 'USERNAME'}" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="{l:T 'ACCESS'}" Binding="{Binding Converter={StaticResource UserAccess}, Mode=OneWay}" Width="1.4*"/>
                        <DataGridTextColumn Header="{l:T 'LAST SIGN-IN'}" Binding="{Binding LastLoginAt, Converter={StaticResource LocalTime}, Mode=OneWay}" Width="130"/>
                        <DataGridTemplateColumn Header="{l:T 'STATUS'}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{l:T 'Active'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="{l:T 'Disabled'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button AutomationProperties.AutomationId="Users_EditButton" Content="{l:T 'Edit'}" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button AutomationProperties.AutomationId="Users_ResetPasswordButton" Content="{l:T 'Reset password'}" Style="{StaticResource LinkButton}" FontSize="12"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button AutomationProperties.AutomationId="Users_DisableButton" Content="{l:T 'Disable'}" Style="{StaticResource LinkButton}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Add / edit form -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <TextBlock x:Name="FullNameLabel" Text="{l:T 'Full name *'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.AutomationId="Users_FullNameBox" AutomationProperties.LabeledBy="{Binding ElementName=FullNameLabel}" MaxLength="150" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="UsernameLabel" Text="{l:T 'Username * (used to sign in)'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.AutomationId="Users_UsernameBox" AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}" MaxLength="64" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="PasswordLabel" Text="{l:T 'First password * (at least 8 characters)'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox AutomationProperties.AutomationId="Users_PasswordBox" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" MaxLength="128" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <CheckBox AutomationProperties.AutomationId="Users_MustChangePasswordCheck" Content="{l:T 'Ask them to choose their own password at first sign-in'}" IsChecked="{Binding MustChangePassword}" Margin="0,0,0,12"/>
                        </StackPanel>

                        <CheckBox AutomationProperties.AutomationId="Users_IsAdminCheck" IsChecked="{Binding IsAdmin}" Margin="0,4,0,4">
                            <TextBlock><Run Text="{l:T 'Admin'}" FontWeight="SemiBold"/> <Run Text="{l:T '(can do everything)'}" Foreground="{StaticResource TextMutedBrush}"/></TextBlock>
                        </CheckBox>

                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <DockPanel Margin="0,12,0,6">
                                <Button AutomationProperties.AutomationId="Users_UseStandardPermissionsButton" DockPanel.Dock="Right" Content="{l:T 'Standard set'}" Style="{StaticResource LinkButton}" FontSize="12"
                                        Command="{Binding UseStandardPermissionsCommand}" ToolTip="{l:T 'Home page actions, suppliers and the logs'}"/>
                                <TextBlock Text="{l:T 'PERMISSIONS'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PermissionOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox AutomationProperties.AutomationId="{Binding Permission, StringFormat='Users_Permission_{0}'}" AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <CheckBox AutomationProperties.AutomationId="Users_IsActiveCheck" Content="{l:T 'Active (can sign in)'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"
                                  Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button AutomationProperties.AutomationId="Users_CancelEditButton" Content="{l:T 'Cancel'}" Margin="0,0,8,0" Command="{Binding CancelEditCommand}"/>
                            <Button AutomationProperties.AutomationId="Users_SaveButton" Content="{l:T 'Save'}" Style="{StaticResource PrimaryButton}" MinWidth="90" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
