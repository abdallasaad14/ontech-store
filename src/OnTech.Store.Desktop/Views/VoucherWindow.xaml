<Window x:Class="OnTech.Store.Desktop.Views.VoucherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
        xmlns:views="clr-namespace:OnTech.Store.Desktop.Views"
        Title="{Binding Heading}" Width="460" Height="600" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" Icon="/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:T 'Close'}" Style="{StaticResource PrimaryButton}" MinWidth="90" IsCancel="True" IsDefault="True" Click="OnClose"/>
        </StackPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>
        <Border Style="{StaticResource Card}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status, Converter={StaticResource Translate}}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Date, Converter={StaticResource LocalTime}, ConverterParameter='dddd d MMMM yyyy, HH:mm'}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding CancelInfo}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding CancelInfo, Converter={StaticResource HasValueToVisibility}}"/>

                    <TextBlock Text="{Binding PartyLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding VoucherLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding VoucherNumber}" FontWeight="SemiBold"/>

                    <StackPanel Visibility="{Binding InvoiceNumber, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{Binding InvoiceLabel}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding InvoiceNumber}"/>
                    </StackPanel>

                    <TextBlock Text="{l:T 'ITEMS'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding ItemName, Mode=OneWay}"/> <Run Text="{Binding ItemCode, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Notes, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{l:T 'NOTES'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{l:T 'BY'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding CreatedBy}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
