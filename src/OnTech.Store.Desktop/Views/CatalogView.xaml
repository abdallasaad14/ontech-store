<UserControl x:Class="OnTech.Store.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <UserControl.Resources>
        <Style x:Key="RowLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="32,28,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox Content="Show disabled" IsChecked="{Binding ShowDisabled}" Margin="0,0,16,0"/>
                <Button Content="+ Category" Margin="0,0,8,0" Command="{Binding NewCategoryCommand}"/>
                <Button Content="+ Item" Style="{StaticResource PrimaryButton}" Command="{Binding NewItemCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Items &amp; Categories" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="What the store holds. Items are disabled, never deleted, so old orders stay complete." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource FieldLabel}" Margin="10,6,0,8"/>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalQuantity}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal"/>
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Items in the selected category -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="16,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,14,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Edit category" Style="{StaticResource RowLink}" Command="{Binding EditCategoryCommand}" CommandParameter="{Binding SelectedCategory}"/>
                            <Button Content="Remove" Style="{StaticResource RowLink}" Foreground="{StaticResource DangerBrush}"
                                    Command="{Binding DeleteCategoryCommand}" CommandParameter="{Binding SelectedCategory}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedCategory.Name}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="6,0,6,6" MouseDoubleClick="OnItemDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="*"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="LOW AT" Binding="{Binding LowStockThreshold}" Width="70"/>
                            <DataGridTemplateColumn Header="STATUS" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><views:StockPill/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Style="{StaticResource RowLink}"
                                                    Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Count" Style="{StaticResource RowLink}" ToolTip="Correct the quantity after a stock count"
                                                    Command="{Binding DataContext.AdjustItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Disable" Style="{StaticResource RowLink}" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.DisableItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Add / edit form -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Width="320" Margin="16,0,0,0"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding IsCategoryForm, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                            <TextBlock Text="Leave empty for the next code (C01, C02, ...)." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource MultiLineTextBox}" Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <CheckBox Content="Active" IsChecked="{Binding CategoryActive}" Margin="0,0,0,18"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsItemForm, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ItemCategory}" DisplayMemberPath="Name" Margin="0,0,0,12"/>
                            <TextBlock Text="Item name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                            <TextBlock Text="Leave empty to generate one from the category, e.g. C01-004." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource MultiLineTextBox}" Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <StackPanel Visibility="{Binding IsNewItem, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Starting quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ItemInitialQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            </StackPanel>
                            <TextBlock Text="Low stock warning at" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ItemLowStock, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Shows &quot;Low&quot; when the quantity falls to this number. 0 turns the warning off." Margin="0,5,0,12"/>
                            <CheckBox Content="Active" IsChecked="{Binding ItemActive}" Margin="0,0,0,18"
                                      Visibility="{Binding IsNewItem, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelFormCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="90" Command="{Binding SaveFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
