<Window x:Class="OnTech.Store.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
        xmlns:views="clr-namespace:OnTech.Store.Desktop.Views"
        Title="{l:T 'Change password'}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/app.ico" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="20" Padding="26">
        <StackPanel>
            <TextBlock Text="{l:T 'Change password'}" Style="{StaticResource PageTitle}" FontSize="19"/>
            <TextBlock Text="{Binding Intro}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"/>
            <views:MessageBanners/>
            <TextBlock x:Name="CurrentLabel" Text="{l:T 'Current password'}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox AutomationProperties.AutomationId="ChangePassword_CurrentBox" AutomationProperties.LabeledBy="{Binding ElementName=CurrentLabel}" MaxLength="128" x:Name="Current" PasswordChanged="OnChanged" Margin="0,0,0,12"/>
            <TextBlock x:Name="NewLabel" Text="{l:T 'New password'}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox AutomationProperties.AutomationId="ChangePassword_NewBox" AutomationProperties.LabeledBy="{Binding ElementName=NewLabel}" MaxLength="128" x:Name="New" PasswordChanged="OnChanged" Margin="0,0,0,12"/>
            <TextBlock x:Name="ConfirmLabel" Text="{l:T 'Type the new password again'}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox AutomationProperties.AutomationId="ChangePassword_ConfirmBox" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmLabel}" MaxLength="128" x:Name="Confirm" PasswordChanged="OnChanged" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button AutomationProperties.AutomationId="ChangePassword_CancelButton" Content="{l:T 'Cancel'}" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button AutomationProperties.AutomationId="ChangePassword_SaveButton" Content="{l:T 'Save password'}" Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
