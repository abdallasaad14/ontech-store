<UserControl x:Class="OnTech.Store.Desktop.Views.StockInsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OnTech.Store.Desktop.Services"
             xmlns:views="clr-namespace:OnTech.Store.Desktop.Views">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{l:T 'Stock In Log'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:T 'Everything received from suppliers, newest first. Search by number, voucher, supplier invoice, supplier or item.'}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <views:MessageBanners DockPanel.Dock="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <Button DockPanel.Dock="Right" Content="{l:T 'Search'}" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T 'Previous'}" Margin="0,0,8,0" Command="{Binding PreviousPageCommand}"/>
                            <Button Content="{l:T 'Next'}" Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding StockIns}" SelectedItem="{Binding Selected}" Margin="6,0,6,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'NO.'}" Binding="{Binding StockInNumber}" Width="110" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="{l:T 'DATE'}" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="{l:T 'SUPPLIER'}" Binding="{Binding SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="{l:T 'UNITS'}" Binding="{Binding TotalQuantity}" Width="70"/>
                            <DataGridTextColumn Header="{l:T 'RECEIPT VOUCHER'}" Binding="{Binding VoucherNumber}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'BY'}" Binding="{Binding CreatedByUserName}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'STATUS'}" Binding="{Binding Status, Converter={StaticResource Translate}, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Selected stock-in -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="320" Margin="16,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource HasValueToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding StockInNumber}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource LocalTime}, ConverterParameter='dddd d MMMM yyyy, HH:mm'}" Style="{StaticResource Hint}"/>

                        <TextBlock Text="{l:T 'SUPPLIER'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding SupplierName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SupplierTaxNumber, StringFormat={l:T 'Tax no. {0}'}}" Style="{StaticResource Hint}"
                                   Visibility="{Binding SupplierTaxNumber, Converter={StaticResource HasValueToVisibility}}"/>

                        <TextBlock Text="{l:T 'ITEMS'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat='+ {0}'}" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding ItemName, Mode=OneWay}"/> <Run Text="{Binding CategoryName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{l:T 'RECEIPT VOUCHER'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding VoucherNumber}" FontWeight="SemiBold"/>

                        <StackPanel Visibility="{Binding SupplierInvoiceNumber, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="{l:T 'SUPPLIER INVOICE'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding SupplierInvoiceNumber}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Notes, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="{l:T 'NOTES'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="{l:T 'CREATED BY'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding CreatedByUserName}"/>

                        <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                                Visibility="{Binding CancelledAt, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}">
                                <Run Text="{l:T 'Cancelled by'}"/> <Run Text="{Binding CancelledByUserName, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding CancelReason, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <Button Content="{l:T 'Cancel stock-in'}" Style="{StaticResource DangerButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.CancelStockInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource CanCancelOrder}">
                                    <Binding Path="DataContext.CanCancel" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
